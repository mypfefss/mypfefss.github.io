# ── Database ──────────────────────────────────────────────────────────────────
# Neon (or any PostgreSQL) connection string.
# For local dev you can use SQLite: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_random_hex_string
JWT_ALGORITHM=HS256
# Access token lifetime in seconds (default 8 h = 28800)
JWT_EXPIRE_SECONDS=28800

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# Example: https://mypfefss.github.io,http://localhost:8001,http://127.0.0.1:8001
ALLOWED_ORIGINS=https://mypfefss.github.io,http://localhost:5500,http://localhost:8001,http://127.0.0.1:5500,http://127.0.0.1:8001,http://localhost:3000

# ── First admin (used by python -m app.create_admin) ─────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Google Drive CV storage ────────────────────────────────────────────────────
# OAuth client credentials and refresh token for the Google account that owns
# the private Drive folder. Keep all credential values secret.
GOOGLE_CLIENT_ID=your_oauth_client_id
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_private_drive_folder_id

# ── Legacy R2 settings (needed only to access CVs uploaded before migration) ───
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mypfe-cvs

# ── CV upload constraints ─────────────────────────────────────────────────────
CV_MAX_BYTES=3145728   # 3 MB

# ── Server ────────────────────────────────────────────────────────────────────
# Maximum total request body size in bytes (default 5 MB)
MAX_REQUEST_BODY_BYTES=5242880
