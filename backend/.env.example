# ── Database ──────────────────────────────────────────────────────────────────
# Neon (or any PostgreSQL) connection string.
# For local dev you can use SQLite: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_random_hex_string
JWT_ALGORITHM=HS256
# Access token lifetime in seconds (default 8 h = 28800)
JWT_EXPIRE_SECONDS=28800

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# Example: https://mypfefss.github.io,http://localhost:5500
ALLOWED_ORIGINS=https://mypfefss.github.io,http://localhost:5500,http://localhost:3000

# ── First admin (used by python -m app.create_admin) ─────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Cloudflare R2 (S3-compatible) ─────────────────────────────────────────────
# All four vars are required for CV uploads to work.
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mypfe-cvs

# ── CV upload constraints ─────────────────────────────────────────────────────
CV_MAX_BYTES=2097152   # 2 MB

# ── Server ────────────────────────────────────────────────────────────────────
# Maximum total request body size in bytes (default 5 MB)
MAX_REQUEST_BODY_BYTES=5242880
